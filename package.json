  "description": "AutoAI desktop application - unified test automation orchestrator (mobile / web / desktop).",
  "private": true,
  "main": "./out/main/index.js",
  "author": "AutoAI",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
